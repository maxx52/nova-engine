# Development only. Do not reuse these credentials in production.
DATABASE_URL=postgres://nova:nova_dev_password@127.0.0.1:5432/nova
POSTGRES_PASSWORD=nova_dev_password
ADMIN_API_KEY=replace-with-a-random-secret-at-least-16-characters
API_HOST=127.0.0.1
PORT=3001

# Cookie sessions. Use HTTPS and SESSION_SECURE=true outside local development.
SESSION_SECURE=false
# Exact browser origins allowed to change administrative data. Add your deployed admin URL here.
ADMIN_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
