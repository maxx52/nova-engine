# Development only. Do not reuse these credentials in production.
DATABASE_URL=postgres://nova:nova_dev_password@127.0.0.1:5432/nova
POSTGRES_PASSWORD=nova_dev_password
ADMIN_API_KEY=replace-with-a-random-secret-at-least-16-characters
API_HOST=127.0.0.1
PORT=3001

# Cookie sessions. Use HTTPS and SESSION_SECURE=true outside local development.
SESSION_SECURE=false
# Exact browser origins allowed to change administrative data. Add your deployed admin URL here.
ADMIN_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Keep false/empty for direct local development. Set loopback ONLY for a local
# reverse proxy that overwrites X-Forwarded-For (see deploy/nginx.conf.example).
TRUST_PROXY=
LOG_LEVEL=info
# Production: set NODE_ENV=production, HTTPS ADMIN_ORIGINS, a random 32+ character
# ADMIN_API_KEY and a DATABASE_URL that does not use development credentials.
# Optional absolute directory for uploads. Default is the repository uploads/.
# UPLOAD_DIRECTORY=/var/lib/nova/uploads
