[Unit]
Description=NOVA encrypted off-site backups to Yandex Disk
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/nova/yandex-rclone.conf

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/lib/nova-external-backup/yandex.py sync
TimeoutStartSec=4h
Nice=10
IOSchedulingClass=idle
CPUQuota=30%
MemoryMax=256M
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/nova-external-backup
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
