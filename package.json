{
  "name": "nova-engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w @nova/api\" \"npm run dev -w @nova/storefront\"",
    "build": "npm run build -w @nova/storefront && npm run build -w @nova/admin",
    "dev:web": "npm run dev -w @nova/storefront",
    "dev:api": "npm run dev -w @nova/api",
    "dev:admin": "npm run dev -w @nova/admin",
    "dev:all": "concurrently -k \"npm run dev -w @nova/api\" \"npm run dev -w @nova/storefront\" \"npm run dev -w @nova/admin\"",
    "test": "node --test",
    "theme:pack": "node scripts/theme-pack.mjs pack",
    "theme:check": "node scripts/theme-pack.mjs check"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
